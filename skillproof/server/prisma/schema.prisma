generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(uuid())
  username     String            @unique
  name         String
  email        String            @unique
  passwordHash String
  role         String            @default("DEVELOPER") // DEVELOPER, RECRUITER, ADMIN
  status       String            @default("ACTIVE")    // ACTIVE, SUSPENDED
  isDemo       Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  profile            DeveloperProfile?
  skills             Skill[]
  assessments        Assessment[]
  projects           Project[]
  bookmarksCreated   Bookmark[]          @relation("RecruiterBookmarks")
  bookmarksReceived  Bookmark[]          @relation("DeveloperBookmarks")
  questionFlags      QuestionFlag[]
  auditLogs          AuditLog[]
  leaderboardEntries LeaderboardEntry[]
}

model DeveloperProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                String?
  githubUrl          String?
  publicSlug         String   @unique
  isPublic           Boolean  @default(true)
  showOnLeaderboard  Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model LeaderboardEntry {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope          String   @default("GLOBAL") // GLOBAL | TRACK | SKILL
  scopeId        String   @default("")       // trackId or skillId/skillCatalogId or ""
  period         String   @default("ALL")    // ALL | MONTH
  periodKey      String   @default("all")    // "all" or "YYYY-MM"
  points         Float    @default(0)
  verifiedSkills String   @default("[]")    // JSON array of strings
  rank           Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([userId, scope, scopeId, period, periodKey])
  @@index([scope, scopeId, period, periodKey, points])
  @@index([userId])
}

model Track {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  skills      SkillCatalog[]
}

model SkillCatalog {
  id            String       @id @default(uuid())
  trackId       String
  track         Track        @relation(fields: [trackId], references: [id], onDelete: Cascade)
  name          String       @unique
  slug          String       @unique
  description   String?
  durationSec   Int          @default(1800)
  questionCount Int          @default(20)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  topics        Topic[]
  skills        Skill[]
  questions     Question[]
  assessments   Assessment[]

  @@index([trackId])
}

model Topic {
  id             String       @id @default(uuid())
  skillCatalogId String
  skillCatalog   SkillCatalog @relation(fields: [skillCatalogId], references: [id], onDelete: Cascade)
  name           String
  weightPercent  Float
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  questions      Question[]

  @@unique([skillCatalogId, name])
  @@index([skillCatalogId])
}

model Skill {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillCatalogId String?
  skillCatalog   SkillCatalog? @relation(fields: [skillCatalogId], references: [id], onDelete: SetNull)
  language       String
  claimedLevel   String        @default("Intermediate") // Beginner, Basic, Intermediate, Advanced, Expert
  certificateUrl String?
  status         String        @default("CLAIMED")      // CLAIMED | VERIFIED
  bestScore      Float?
  verifiedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  assessments    Assessment[]

  @@unique([userId, language])
  @@index([userId])
  @@index([skillCatalogId])
}

model Question {
  id             String               @id @default(uuid())
  skillCatalogId String?
  skillCatalog   SkillCatalog?        @relation(fields: [skillCatalogId], references: [id], onDelete: SetNull)
  topicId        String?
  topicRelation  Topic?               @relation(fields: [topicId], references: [id], onDelete: SetNull)
  language       String
  topic          String
  difficulty     String               // EASY | MEDIUM | HARD
  type           String               @default("MCQ") // MCQ | MULTI | CODE_OUTPUT | SCENARIO
  prompt         String
  options        String               // JSON array of strings
  correctAnswer  String               // JSON array or string
  explanation    String
  status         String               @default("ACTIVE") // ACTIVE | FLAGGED | RETIRED
  createdBy      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  assessmentQuestions AssessmentQuestion[]
  flags               QuestionFlag[]

  @@index([language, difficulty, status])
  @@index([language, topic])
  @@index([skillCatalogId])
  @@index([topicId])
}

model Assessment {
  id              String               @id @default(uuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId         String
  skill           Skill                @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillCatalogId  String?
  skillCatalog    SkillCatalog?        @relation(fields: [skillCatalogId], references: [id], onDelete: SetNull)
  language        String
  startedAt       DateTime             @default(now())
  submittedAt     DateTime?
  durationSec     Int                  @default(1800) // 30 minutes default
  status          String               @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | EXPIRED
  scorePercent    Float?
  weightedPercent Float?
  level           String?              // Beginner, Basic, Intermediate, Advanced, Expert
  tabSwitchCount  Int                  @default(0)
  topicBreakdown  String?              // JSON object of topic accuracy
  coverage        String?              // JSON object { topicsCovered, questionsAnswered, attemptsCount }
  confidence      String?              // Low | Medium | High
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  questions       AssessmentQuestion[]

  @@index([userId, language])
  @@index([skillCatalogId])
}

model AssessmentQuestion {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order        Int
  userAnswer   String?    // JSON representation of answer
  isCorrect    Boolean?
  timeTakenSec Int?
  createdAt    DateTime   @default(now())

  @@index([assessmentId])
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  repoUrl     String?
  techStack   String   // comma-separated or JSON list
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Bookmark {
  id          String   @id @default(uuid())
  recruiterId String
  recruiter   User     @relation("RecruiterBookmarks", fields: [recruiterId], references: [id], onDelete: Cascade)
  developerId String
  developer   User     @relation("DeveloperBookmarks", fields: [developerId], references: [id], onDelete: Cascade)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([recruiterId, developerId])
}

model QuestionFlag {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reportedBy String
  reporter   User     @relation(fields: [reportedBy], references: [id], onDelete: Cascade)
  reason     String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([questionId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
}
